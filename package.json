{
  "name": "starter",
  "displayName": "Starter",
  "version": "0.3.2",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run typecheck && bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "check:docs-cover": "node scripts/check-docs-cover.mjs",
    "test": "npm run test:unit && npm run check:docs-cover",
    "test:unit": "node --experimental-sqlite --experimental-strip-types --test test/*.test.ts",
    "test:build": "npm run build",
    "release:check": "npm test && npm run test:generate && npm run generate && npm run lint && npm run test:build",
    "preversion": "bash scripts/preversion.sh",
    "postversion": "git push --atomic origin main v$npm_package_version",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "bash scripts/sites-env.sh -- tsc --noEmit",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "generate": "node scripts/generate.mjs",
    "test:generate": "node --test scripts/generate.test.mjs scripts/publish-template.test.mjs scripts/template-backups.test.mjs",
    "template:backups": "node scripts/template-backups.mjs",
    "template:publish": "node scripts/publish-template.mjs",
    "capture:cover": "node tools/cover/capture.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "miniflare": "5.20260921.0-alpha",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.11",
    "vite": "8.3.0",
    "wrangler": "4.136.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260921.1": true
  }
}
